{
  "name": "tft-item-lookup",
  "version": "0.1.1",
  "description": "Tra cứu thống kê trang bị TFT từ tactics.tools",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "check": "node --check electron/main.js && node --check electron/preload.js && node --check electron/cache-store.js && node --check electron/tactics-tools-client.js && node --check electron/update-manager.js && node --check scripts/build-release.js && node --check src/app.js",
    "package:win": "electron-builder --win portable",
    "package:dir": "electron-builder --dir --win",
    "package:release": "node scripts/build-release.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.personal.tft-item-lookup",
    "productName": "TFT Item Lookup",
    "artifactName": "TFT-Item-Lookup-${version}-portable.${ext}",
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json",
      "node_modules/vue/dist/vue.global.prod.js"
    ],
    "win": {
      "target": "portable"
    }
  }
}
